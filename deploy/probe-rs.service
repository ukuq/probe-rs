[Unit]
Description=probe-rs server monitoring agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 默认配置路径即 /etc/probe-rs/config.toml，无需 -c 参数
ExecStart=/usr/local/bin/probe-rs
Restart=always
RestartSec=5

# agent 需要：读 /proc、出站 HTTP/TCP、写两个路径——
#   /var/lib/probe-rs  netstatic 流量时序落盘
#   /etc/probe-rs      远端下发配置时回写 config.toml（设计如此）
# 「-」前缀 = 目录缺失时不影响启动（agent 会自建，install.sh 也会建）
# 注意：net_static_path 若改到这两个目录之外，需自行加 ReadWritePaths，
#       否则 ProtectSystem=strict 下 flush 会一直 EROFS
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=-/var/lib/probe-rs -/etc/probe-rs
ProtectHome=true
PrivateTmp=true

# 若未来启用 ICMP ping（原始套接字），解开下一行：
# AmbientCapabilities=CAP_NET_RAW

[Install]
WantedBy=multi-user.target
